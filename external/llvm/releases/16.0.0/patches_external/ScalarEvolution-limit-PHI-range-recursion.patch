diff --git a/llvm/test/Analysis/ScalarEvolution/phi-range-recursion.ll b/llvm/test/Analysis/ScalarEvolution/phi-range-recursion.ll
new file mode 100644
--- /dev/null
+++ b/llvm/test/Analysis/ScalarEvolution/phi-range-recursion.ll
@@ -0,0 +1,22 @@
+; RUN: opt -passes='print<scalar-evolution>' -disable-output %s 2>&1 | FileCheck %s
+; RUN: opt -passes='print<scalar-evolution>' -scev-range-iter-threshold=1 -disable-output %s 2>&1 | FileCheck %s
+; RUN: %python %S/Inputs/phi-range-recursion.py > %t.ll
+; RUN: opt -passes='print<scalar-evolution>' -disable-output %t.ll 2> %t.out
+; RUN: opt -passes='print<scalar-evolution>' -scev-range-iter-threshold=1 -disable-output %t.ll 2> %t.iter.out
+;
+; A nonlinear recurrence must not recursively request SCEVs of its backedge
+; inputs from getRangeRef. ValueTracking still supplies a conservative range.
+define void @cyclic_phi(i32 %n) {
+; CHECK-LABEL: 'cyclic_phi'
+; CHECK: %iv = phi i32
+; CHECK-NEXT: --> %iv U: [0,-7) S: [-2147483648,2147483641)
+entry:
+  br label %loop
+loop:
+  %iv = phi i32 [ 0, %entry ], [ %next, %loop ]
+  %next = mul nuw i32 %iv, 8
+  %cmp = icmp ult i32 %next, %n
+  br i1 %cmp, label %loop, label %exit
+exit:
+  ret void
+}
diff --git a/llvm/test/Analysis/ScalarEvolution/Inputs/phi-range-recursion.py b/llvm/test/Analysis/ScalarEvolution/Inputs/phi-range-recursion.py
new file mode 100644
--- /dev/null
+++ b/llvm/test/Analysis/ScalarEvolution/Inputs/phi-range-recursion.py
@@ -0,0 +1,22 @@
+# Generate a chain whose SCEV construction used to recurse through select-like
+# PHIs. Visiting the last value first prevents the printer from warming caches.
+print("define i32 @deep_phi(i1 %cond, i32 %start) {")
+print("entry:")
+print("  br label %branch0")
+for i in reversed(range(8192)):
+    previous = "%start" if i == 0 else "%p" + str(i - 1)
+    print("branch%d:" % i)
+    print("  br i1 %%cond, label %%left%d, label %%right%d" % (i, i))
+    print("left%d:" % i)
+    print("  %%a%d = add i32 %s, 1" % (i, previous))
+    print("  br label %%merge%d" % i)
+    print("right%d:" % i)
+    print("  br label %%merge%d" % i)
+    print("merge%d:" % i)
+    print("  %%p%d = phi i32 [ %%a%d, %%left%d ], [ %s, %%right%d ]" %
+          (i, i, i, previous, i))
+    if i == 8191:
+        print("  ret i32 %%p%d" % i)
+    else:
+        print("  br label %%branch%d" % (i + 1))
+print("}")
