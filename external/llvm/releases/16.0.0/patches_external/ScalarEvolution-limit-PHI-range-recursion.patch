+static bool getOperandsForSelectLikePHI(DominatorTree &DT, LoopInfo &LI,
+                                        PHINode *PN, Value *&Cond, Value *&LHS,
+                                        Value *&RHS) {
   auto IsReachable =
       [&](BasicBlock *BB) { return DT.isReachableFromEntry(BB); };
