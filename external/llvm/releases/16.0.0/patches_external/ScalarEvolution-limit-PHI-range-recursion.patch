+// Restrict PHI traversal to acyclic dependencies. A visited set alone does not
+// prevent getRangeRef and createSCEVIter from recursively calling each other
+// while creating SCEVs for PHI operands (LLVM issue #148253).
+static bool RangeRefPHIAllowedOperands(DominatorTree &DT, LoopInfo &LI,
+                                       PHINode *PHI) {
+  Value *Cond = nullptr, *LHS = nullptr, *RHS = nullptr;
+  if (getOperandsForSelectLikePHI(DT, LI, PHI, Cond, LHS, RHS))
+    return true;
+
+  return all_of(PHI->operands(),
+                [&](Value *Operand) { return DT.dominates(Operand, PHI); });
+}
