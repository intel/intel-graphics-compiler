+  const Loop *L = LI.getLoopFor(PN->getParent());
+  // Preserve LLVM 16's LCSSA restriction for select-like PHIs.
+  for (BasicBlock *IncomingBB : PN->blocks())
+    if (LI.getLoopFor(IncomingBB) != L)
