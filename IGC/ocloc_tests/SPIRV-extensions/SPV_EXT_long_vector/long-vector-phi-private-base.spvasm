; LongVectorsOpt moves the loop-carried <1024 x i32> phi to an alloca it
; creates itself, in a kernel without any other private memory, so
; PrivateMemoryUsageAnalysis has to add the private base implicit argument in
; advance. Without it the compilation crashes. The insert at a dynamic index
; keeps the phi a vector until LongVectorsOpt, and stores the element at a
; dynamic offset, so the alloca isn't promoted back to registers.

; REQUIRES: regkeys, spirv-as
; RUN: spirv-as --target-env spv1.3 -o %t.spv %s
; RUN: %if dg2-supported %{ ocloc compile -spirv_input -file %t.spv -device dg2 -options " -igc_opts 'PrintToConsole=1 PrintAfter=igc-long-vectors-opt'" 2>&1 | FileCheck %s %}
; RUN: %if mtl-supported %{ ocloc compile -spirv_input -file %t.spv -device mtl -options " -igc_opts 'PrintToConsole=1 PrintAfter=igc-long-vectors-opt'" 2>&1 | FileCheck %s %}

; CHECK: alloca <1024 x i32>
; CHECK: Build succeeded

; LongVectorEXT (5425) is a raw word, as SPIRV-Tools doesn't know it yet.

               OpCapability Addresses
               OpCapability Kernel
               OpCapability !5425
               OpExtension "SPV_EXT_long_vector"
               OpMemoryModel Physical64 OpenCL
               OpEntryPoint Kernel %k "k"
       %void = OpTypeVoid
       %uint = OpTypeInt 32 0
       %bool = OpTypeBool
   %uint1024 = OpTypeVector %uint 1024
 %p_uint1024 = OpTypePointer CrossWorkgroup %uint1024
         %fn = OpTypeFunction %void %p_uint1024 %uint
         %c0 = OpConstant %uint 0
         %c1 = OpConstant %uint 1
          %k = OpFunction %void None %fn
          %p = OpFunctionParameter %p_uint1024
          %n = OpFunctionParameter %uint
      %entry = OpLabel
          %v = OpLoad %uint1024 %p Aligned 4096
               OpBranch %loop
       %loop = OpLabel
          %i = OpPhi %uint %c0 %entry %inext %loop
        %acc = OpPhi %uint1024 %v %entry %accnext %loop
    %accnext = OpVectorInsertDynamic %uint1024 %acc %i %i
      %inext = OpIAdd %uint %i %c1
       %cond = OpULessThan %bool %inext %n
               OpBranchConditional %cond %loop %exit
       %exit = OpLabel
               OpStore %p %acc Aligned 4096
               OpReturn
               OpFunctionEnd
