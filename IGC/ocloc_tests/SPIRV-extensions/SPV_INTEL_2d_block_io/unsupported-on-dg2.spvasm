; REQUIRES: spirv-as, dg2-supported
; RUN: spirv-as --target-env spv1.0 -o %t.spv %s
; RUN: not ocloc compile -spirv_input -file %t.spv -device dg2 2>&1 | FileCheck %s

; Make sure we emit the error but don't crash.

; CHECK: uses extension 'SPV_INTEL_2d_block_io' which were disabled
; CHECK: Build failed

               OpCapability Addresses
               OpCapability Kernel
               OpCapability Subgroup2DBlockIOINTEL
               OpExtension "SPV_INTEL_2d_block_io"
               OpMemoryModel Physical64 OpenCL
               OpEntryPoint Kernel %k "probe"
       %void = OpTypeVoid
         %fn = OpTypeFunction %void
          %k = OpFunction %void None %fn
      %entry = OpLabel
               OpReturn
               OpFunctionEnd
