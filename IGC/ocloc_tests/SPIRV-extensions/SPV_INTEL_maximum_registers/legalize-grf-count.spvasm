; UNSUPPORTED: system-windows
; REQUIRES: spirv-as, regkeys, bmg-supported, ptl-supported
; RUN: spirv-as --target-env spv1.0 -o %t.spv %s

; RUN: ocloc compile -spirv_input -file %t.spv -device ptl -output_no_suffix -output %t_ptl_out \
; RUN:   -options "-igc_opts 'ShaderDumpEnable=1,DumpToCustomDir=%t_ptl_dump'" | FileCheck %s --check-prefix=NO-WARN
; RUN: FileCheck %s --check-prefix=PTL --input-file %t_ptl_dump/*.zeinfo

; RUN: ocloc compile -spirv_input -file %t.spv -device bmg -output_no_suffix -output %t_bmg_out \
; RUN:   -options "-igc_opts 'ShaderDumpEnable=1,DumpToCustomDir=%t_bmg_dump'" | FileCheck %s --check-prefix=WARN
; RUN: FileCheck %s --check-prefix=BMG --input-file %t_bmg_dump/*.zeinfo

; PTL: grf_count:       192
; BMG: grf_count:       128

; NO-WARN-NOT: registers per thread is not supported
; WARN: warning: in kernel 'test': Requested maximum of 192 registers per thread is not supported on this platform; using 128

               OpCapability Addresses
               OpCapability Kernel
               OpCapability RegisterLimitsINTEL
               OpExtension "SPV_INTEL_maximum_registers"
               OpMemoryModel Physical64 OpenCL
               OpEntryPoint Kernel %test "test"
               OpExecutionMode %test MaximumRegistersINTEL 192
               OpName %test "test"
       %void = OpTypeVoid
          %3 = OpTypeFunction %void
       %test = OpFunction %void None %3
          %5 = OpLabel
               OpReturn
               OpFunctionEnd
