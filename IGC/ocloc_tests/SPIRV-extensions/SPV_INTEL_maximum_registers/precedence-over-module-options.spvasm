; UNSUPPORTED: system-windows
; REQUIRES: spirv-as, regkeys, bmg-supported
; RUN: spirv-as --target-env spv1.0 -o %t.spv %s

; RUN: ocloc compile -spirv_input -file %t.spv -device bmg -output_no_suffix -output %t_a_out \
; RUN:   -options "-ze-exp-register-file-size=128 -igc_opts 'ShaderDumpEnable=1,DumpToCustomDir=%t_a_dump'"
; RUN: FileCheck %s --input-file %t_a_dump/*.zeinfo

; RUN: ocloc compile -spirv_input -file %t.spv -device bmg -output_no_suffix -output %t_b_out \
; RUN:   -options "-ze-intel-enable-auto-large-GRF-mode -igc_opts 'ShaderDumpEnable=1,DumpToCustomDir=%t_b_dump'"
; RUN: FileCheck %s --input-file %t_b_dump/*.zeinfo

; CHECK: grf_count:       256

               OpCapability Addresses
               OpCapability Kernel
               OpCapability RegisterLimitsINTEL
               OpExtension "SPV_INTEL_maximum_registers"
               OpMemoryModel Physical64 OpenCL
               OpEntryPoint Kernel %test "test"
               OpExecutionMode %test MaximumRegistersINTEL 256
               OpName %test "test"
       %void = OpTypeVoid
          %3 = OpTypeFunction %void
       %test = OpFunction %void None %3
          %5 = OpLabel
               OpReturn
               OpFunctionEnd
