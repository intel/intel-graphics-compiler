; UNSUPPORTED: system-windows
; REQUIRES: spirv-as, regkeys, debug, bmg-supported
; RUN: spirv-as --target-env spv1.0 -o %t.spv %s

; Without the registry key, AutoINTEL must still reach vISA as auto mode - this
; guards against the guard below being made too broad.
; RUN: ocloc compile -spirv_input -file %t.spv -device bmg -output_no_suffix -output %t_auto_out \
; RUN:   -options "-igc_opts 'VISAOptions=-dumpVisaOptions'" 2>&1 | FileCheck %s --check-prefix=AUTO

; With the registry key, auto mode must not be enabled on top of it.
; RUN: ocloc compile -spirv_input -file %t.spv -device bmg -output_no_suffix -output %t_out \
; RUN:   -options "-igc_opts 'TotalGRFNum=256,VISAOptions=-dumpVisaOptions,ShaderDumpEnable=1,DumpToCustomDir=%t_dump'" \
; RUN:   2>&1 | FileCheck %s --check-prefix=NOAUTO
; RUN: FileCheck %s --check-prefix=ZEINFO --input-file %t_dump/*.zeinfo

; AUTO: vISA_AutoGRFSelection{{.*}}true

; NOAUTO: vISA_TotalGRFNum{{.*}}256
; NOAUTO-NOT: vISA_AutoGRFSelection

; Both kernels follow the registry key, not their own execution mode.
; ZEINFO-LABEL: - name: explicit_128
; ZEINFO: grf_count:       256
; ZEINFO-LABEL: - name: named_auto
; ZEINFO: grf_count:       256

               OpCapability Addresses
               OpCapability Kernel
               OpCapability RegisterLimitsINTEL
               OpExtension "SPV_INTEL_maximum_registers"
               OpMemoryModel Physical64 OpenCL
               OpEntryPoint Kernel %explicit_128 "explicit_128"
               OpEntryPoint Kernel %named_auto "named_auto"
               OpExecutionMode %explicit_128 MaximumRegistersINTEL 128
               OpExecutionMode %named_auto NamedMaximumRegistersINTEL AutoINTEL
               OpName %explicit_128 "explicit_128"
               OpName %named_auto "named_auto"
       %void = OpTypeVoid
          %3 = OpTypeFunction %void
%explicit_128 = OpFunction %void None %3
          %5 = OpLabel
               OpReturn
               OpFunctionEnd
 %named_auto = OpFunction %void None %3
          %7 = OpLabel
               OpReturn
               OpFunctionEnd
