; UNSUPPORTED: system-windows
; REQUIRES: spirv-as, regkeys, cri-supported, bmg-supported
; RUN: spirv-as --target-env spv1.0 -o %t.spv %s

; RUN: ocloc compile -spirv_input -file %t.spv -device cri -output_no_suffix -output %t_cri_out \
; RUN:   -options "-igc_opts 'ShaderDumpEnable=1,DumpToCustomDir=%t_cri_dump'" | FileCheck %s --check-prefix=NO-WARN
; RUN: FileCheck %s --check-prefix=CRI --input-file %t_cri_dump/*.zeinfo

; RUN: ocloc compile -spirv_input -file %t.spv -device bmg -output_no_suffix -output %t_bmg_out \
; RUN:   -options "-igc_opts 'ShaderDumpEnable=1,DumpToCustomDir=%t_bmg_dump'" | FileCheck %s --check-prefix=WARN
; RUN: FileCheck %s --check-prefix=BMG --input-file %t_bmg_dump/*.zeinfo

; CRI: grf_count:       512
; BMG: grf_count:       256

; NO-WARN-NOT: registers per thread is not supported
; WARN: warning: in kernel 'test': Requested maximum of 512 registers per thread is not supported on this platform; using 256

               OpCapability Addresses
               OpCapability Kernel
               OpCapability RegisterLimitsINTEL
               OpExtension "SPV_INTEL_maximum_registers"
               OpMemoryModel Physical64 OpenCL
               OpEntryPoint Kernel %test "test"
               OpExecutionMode %test MaximumRegistersINTEL 512
               OpName %test "test"
       %void = OpTypeVoid
          %3 = OpTypeFunction %void
       %test = OpFunction %void None %3
          %5 = OpLabel
               OpReturn
               OpFunctionEnd
