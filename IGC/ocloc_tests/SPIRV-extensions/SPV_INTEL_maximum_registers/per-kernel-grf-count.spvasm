; UNSUPPORTED: system-windows
; REQUIRES: spirv-as, regkeys, bmg-supported
; RUN: spirv-as --target-env spv1.0 -o %t.spv %s
; RUN: ocloc compile -spirv_input -file %t.spv -device bmg -output_no_suffix -output %t_out \
; RUN:   -options "-igc_opts 'ShaderDumpEnable=1,DumpToCustomDir=%t_dump'"
; RUN: FileCheck %s --input-file %t_dump/*.zeinfo

; CHECK-LABEL: - name: high_occupancy
; CHECK: execution_env:
; CHECK: grf_count:       128
; CHECK-LABEL: - name: high_reg_demand
; CHECK: execution_env:
; CHECK: grf_count:       256

               OpCapability Addresses
               OpCapability Kernel
               OpCapability RegisterLimitsINTEL
               OpExtension "SPV_INTEL_maximum_registers"
               OpMemoryModel Physical64 OpenCL
               OpEntryPoint Kernel %high_occupancy "high_occupancy"
               OpEntryPoint Kernel %high_reg_demand "high_reg_demand"
               OpExecutionMode %high_occupancy MaximumRegistersINTEL 128
               OpExecutionMode %high_reg_demand MaximumRegistersINTEL 256
               OpName %high_occupancy "high_occupancy"
               OpName %high_reg_demand "high_reg_demand"
       %void = OpTypeVoid
          %3 = OpTypeFunction %void
%high_occupancy = OpFunction %void None %3
          %5 = OpLabel
               OpReturn
               OpFunctionEnd
%high_reg_demand = OpFunction %void None %3
          %7 = OpLabel
               OpReturn
               OpFunctionEnd
