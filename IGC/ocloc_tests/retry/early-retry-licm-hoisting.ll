; REQUIRES: ptl-supported, llvm-17-plus
; RUN: llvm-as %s -o %t.bc
; RUN: ocloc compile -llvm_input -file %t.bc -device ptl -options "-ze-exp-register-file-size=192" 2>&1 | FileCheck %s

; Reduced from a spilling kernel: two large reductions over loop-invariant
; loaded values are computed inside the loop. Register pressure is high enough
; for early retry, but LICM hoists both reductions out of the loop. A retry
; disables LICM and puts that work back into the loop, which makes spilling
; much worse, so shouldForceEarlyRecompile must not skip the first stage.
;
; The first stage is compiled and spills, the regular retry runs, and the retry
; manager keeps the first-stage kernel because the retry spills more. With early
; retry the first stage would never be compiled, so the second check would fail.

; CHECK: [RetryManager] Start recompilation of the kernel
; CHECK: [RetryManager] Used previous version of the kernel, reason : NO_Retry_Pick_Prv

target datalayout = "e-p:64:64:64-i1:8:8-i8:8:8-i16:16:16-i32:32:32-i64:64:64-f32:32:32-f64:64:64-v16:16:16-v24:32:32-v32:32:32-v48:64:64-v64:64:64-v96:128:128-v128:128:128-v192:256:256-v256:256:256-v512:512:512-v1024:1024:1024-G1"
target triple = "spir64-unknown-unknown"

