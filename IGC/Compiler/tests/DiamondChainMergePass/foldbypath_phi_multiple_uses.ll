;
; Test FoldByPath: PHI value used multiple times in dependent diamond
; Ensures all operands are correctly replaced with resolved values.
;
; REQUIRES: llvm-22-plus, !llvm-23-plus
; RUN: igc_opt --opaque-pointers %s -S -o - -diamond-chain-merge | FileCheck %s

define void @foldbypath_phi_multiple_uses(i1 %cmp, i32 %x, ptr addrspace(1) %out) {
; CHECK-LABEL: define void @foldbypath_phi_multiple_uses(
; CHECK-SAME: i1 [[CMP:%.*]], i32 [[X:%.*]], ptr addrspace(1) [[OUT:%.*]]) {
; CHECK-NEXT:  entry:
; CHECK-NEXT:    br i1 [[CMP]], label %[[TRUE_PATH:.*]], label %[[FALSE_PATH:.*]]
; CHECK:       [[TRUE_PATH]]:
; CHECK-NEXT:    [[T0:%.*]] = add i32 [[X]], 10
; CHECK-NEXT:    [[TMP0:%.*]] = mul i32 [[T0]], [[T0]]
; CHECK-NEXT:    [[TMP1:%.*]] = add i32 [[TMP0]], [[T0]]
; CHECK-NEXT:    store i32 [[TMP1]], ptr addrspace(1) [[OUT]], align 4
; CHECK-NEXT:    ret void
; CHECK:       [[FALSE_PATH]]:
; CHECK-NEXT:    [[F0:%.*]] = add i32 [[X]], 20
; CHECK-NEXT:    [[TMP2:%.*]] = mul i32 [[F0]], [[F0]]
; CHECK-NEXT:    [[TMP3:%.*]] = add i32 [[TMP2]], [[F0]]
; CHECK-NEXT:    store i32 [[TMP3]], ptr addrspace(1) [[OUT]], align 4
; CHECK-NEXT:    ret void
;
entry:
  br i1 %cmp, label %true0, label %false0

true0:
  %t0 = add i32 %x, 10
  br label %merge0

false0:
  %f0 = add i32 %x, 20
  br label %merge0

merge0:
  %v0 = phi i32 [%t0, %true0], [%f0, %false0]
  br i1 %cmp, label %true1, label %false1

; Second diamond uses %v0 multiple times
true1:
  %mul_t = mul i32 %v0, %v0
  %add_t = add i32 %mul_t, %v0
  br label %merge1

false1:
  %mul_f = mul i32 %v0, %v0
  %add_f = add i32 %mul_f, %v0
  br label %merge1

merge1:
  %result = phi i32 [%add_t, %true1], [%add_f, %false1]
  store i32 %result, ptr addrspace(1) %out, align 4
  ret void
}
