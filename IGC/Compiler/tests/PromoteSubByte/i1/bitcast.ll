; RUN: igc_opt --opaque-pointers -igc-promote-sub-byte -S %s | FileCheck %s

; Promoting <N x i1> to <N x i8> changes the bit width, so bitcasts between bool
; vectors and integers must stay at the original types.

; The i2 is not promoted, so it is cast from the original <2 x i1>.
; CHECK-LABEL: define i8 @vec_to_i2(
; CHECK-NEXT:    [[CMP:%.*]] = icmp ne <2 x i64> %v, zeroinitializer
; CHECK-NEXT:    [[BC:%.*]] = bitcast <2 x i1> [[CMP]] to i2
; CHECK-NEXT:    icmp ne i2 [[BC]], 0
define i1 @vec_to_i2(<2 x i64> %v) {
  %cmp = icmp ne <2 x i64> %v, zeroinitializer
  %bc = bitcast <2 x i1> %cmp to i2
  %any = icmp ne i2 %bc, 0
  ret i1 %any
}

; The i4 result keeps its value in the low bits of the promoted i8.
; CHECK-LABEL: define i8 @vec_to_i4(
; CHECK-NEXT:    [[CMP:%.*]] = icmp ne <4 x i32> %v, zeroinitializer
; CHECK-NEXT:    [[BC:%.*]] = bitcast <4 x i1> [[CMP]] to i4
; CHECK-NEXT:    [[EXT:%.*]] = zext i4 [[BC]] to i8
; CHECK-NEXT:    icmp ne i8 [[EXT]], 0
define i1 @vec_to_i4(<4 x i32> %v) {
  %cmp = icmp ne <4 x i32> %v, zeroinitializer
  %bc = bitcast <4 x i1> %cmp to i4
  %any = icmp ne i4 %bc, 0
  ret i1 %any
}

; The bitcast packs the original <8 x i1>; widened lanes would not fit in an i8.
; CHECK-LABEL: define void @vec_to_i8(
; CHECK-NEXT:    [[CMP:%.*]] = icmp sgt <8 x i32> %v, zeroinitializer
; CHECK-NEXT:    [[BC:%.*]] = bitcast <8 x i1> [[CMP]] to i8
; CHECK-NEXT:    store i8 [[BC]], ptr %dst, align 1
define void @vec_to_i8(<8 x i32> %v, ptr %dst) {
  %cmp = icmp sgt <8 x i32> %v, zeroinitializer
  %bc = bitcast <8 x i1> %cmp to i8
  store i8 %bc, ptr %dst, align 1
  ret void
}

; The unpacked bools are widened after the bitcast, since stores take promoted types.
; CHECK-LABEL: define void @i8_to_vec(
; CHECK-NEXT:    [[BC:%.*]] = bitcast i8 %mask to <8 x i1>
; CHECK-NEXT:    [[EXT:%.*]] = zext <8 x i1> [[BC]] to <8 x i8>
; CHECK-NEXT:    store <8 x i8> [[EXT]], ptr %dst, align 1
define void @i8_to_vec(i8 %mask, ptr %dst) {
  %bc = bitcast i8 %mask to <8 x i1>
  store <8 x i1> %bc, ptr %dst, align 1
  ret void
}

; The promoted i4 must be truncated back to i4 before the bitcast.
; CHECK-LABEL: define void @i4_to_vec(
; CHECK-NEXT:    [[TR:%.*]] = trunc i8 %mask to i4
; CHECK-NEXT:    [[BC:%.*]] = bitcast i4 [[TR]] to <4 x i1>
; CHECK-NEXT:    [[EXT:%.*]] = zext <4 x i1> [[BC]] to <4 x i8>
; CHECK-NEXT:    store <4 x i8> [[EXT]], ptr %dst, align 1
define void @i4_to_vec(i4 %mask, ptr %dst) {
  %bc = bitcast i4 %mask to <4 x i1>
  store <4 x i1> %bc, ptr %dst, align 1
  ret void
}
