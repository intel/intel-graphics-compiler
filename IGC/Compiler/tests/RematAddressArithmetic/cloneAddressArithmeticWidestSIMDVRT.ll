; REQUIRES: regkeys
; UNSUPPORTED: system-windows
; Test the XE3 VRT SIMD16 preference at the widest SIMD on PTL. Estimated pressure is 82 GRFs
; at SIMD16 and 164 GRFs at SIMD32, so the SIMD16 drop prefers SIMD16 for @unconstrained and
; its pressure is estimated at SIMD16, which is not rematerialized. @required32 has a required
; sub-group size of 32 and ForceOCLSIMDWidth=32 fixes the width, so those are estimated at
; SIMD32 and rematerialized.

; RUN: igc_opt -platformPtl --opaque-pointers %s -S -o - -igc-clone-address-arithmetic -remat-widest-simd --regkey=RematChainLimit=3 --regkey=RematFlowThreshold=1 --regkey=AllowSIMD16DropForXE2Plus=1 --dce | FileCheck %s --check-prefix=DEFAULT
; RUN: igc_opt -platformPtl --opaque-pointers %s -S -o - -igc-clone-address-arithmetic -remat-widest-simd --regkey=RematChainLimit=3 --regkey=RematFlowThreshold=1 --regkey=AllowSIMD16DropForXE2Plus=1 --dce --regkey=ForceOCLSIMDWidth=32 | FileCheck %s --check-prefix=FORCED

; DEFAULT-LABEL: define spir_kernel void @unconstrained(
; DEFAULT-NOT: !remat
