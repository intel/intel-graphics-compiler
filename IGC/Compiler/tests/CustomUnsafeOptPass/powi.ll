; CustomUnsafeOptPass expands llvm.powi with a constant exponent into a
; multiplication chain built by repeated squaring. Exponents that need more
; than PowiExpandMaxMuls (default 5) multiplications stay powi.

define float @test_powi_0(float %x) {
; CHECK-LABEL: define float @test_powi_0(
; CHECK-SAME: float [[X:%.*]]) {
; CHECK-NEXT:    ret float 1.000000e+00
;
  %r = call float @llvm.powi.f32.i32(float %x, i32 0)
  ret float %r
}

