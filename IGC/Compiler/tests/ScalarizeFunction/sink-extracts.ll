  %i = phi i32 [ 0, %entry ], [ %i.next, %latch ]
  %acc = phi <8 x float> [ zeroinitializer, %entry ], [ %dpas, %latch ]
  %cmp = icmp ult i32 %i, %n
  br i1 %cmp, label %latch, label %exit
latch:
  %dpas = call <8 x float> @llvm.genx.GenISA.sub.group.dpas.v8f32.v8f32.v8i16.v8i32(<8 x float> %acc, <8 x i16> %a, <8 x i32> %b, i32 11, i32 11, i32 8, i32 8, i1 false)
