# REQUIRES: regkeys

# RUN: env IGC_ShaderDumpTranslationOnly=1 IGCOCLInterfaceTester platform_check --platform dg2 2>/dev/null | FileCheck %s
# RUN: env IGC_ShaderDumpTranslationOnly=1 IGCOCLInterfaceTester platform_check --platform dg2 --gmdid 0.0 2>/dev/null | FileCheck %s

# CHECK:      renderBlockID=not-reported
# CHECK-NEXT: warning: render GMDID was not reported, so the reported platform could not be validated. Compiling for IGFX_DG2 ({{[0-9]+}}) / IGFX_XE_HPG_CORE ({{[0-9]+}}) as reported by the runtime.
